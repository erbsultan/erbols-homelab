logging {
  level  = "info"
  format = "logfmt"
}

loki.source.file "nginx" {
  targets = [
    {
      __path__         = "/var/log/nginx/*.log",
      __path_exclude__ = "/var/log/nginx/*.gz",
      instance         = "homelab-fra-01",
      job              = "nginx",
      service          = "nginx",
    },
  ]

  forward_to = [loki.write.local.receiver]

  file_match {
    enabled     = true
    sync_period = "10s"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
